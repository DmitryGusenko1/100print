[Unit]
Description=AI Business Brain Telegram Bot
After=network.target postgresql.service

[Service]
Type=simple
User=ai-brain
Group=ai-brain
WorkingDirectory=/opt/ai-business-brain
EnvironmentFile=/opt/ai-business-brain/.env
ExecStart=/opt/ai-business-brain/.venv/bin/python -m app.bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
