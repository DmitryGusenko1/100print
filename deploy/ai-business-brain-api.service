[Unit]
Description=AI Business Brain API
After=network-online.target ai-business-brain-postgres.service
Requires=ai-business-brain-postgres.service

[Service]
Type=simple
User=ceoorch
Group=ceoorch
WorkingDirectory=/opt/ceo-orchestrator/ai-business-brain
EnvironmentFile=/opt/ceo-orchestrator/ai-business-brain/.env
ExecStartPre=/opt/ceo-orchestrator/ai-business-brain/.venv/bin/alembic upgrade head
ExecStart=/opt/ceo-orchestrator/ai-business-brain/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18090
StandardOutput=append:/opt/ceo-orchestrator/ai-business-brain/logs/api.log
StandardError=inherit
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
