[Unit]
Description=AI Memory API
After=network.target postgresql.service

[Service]
Type=simple
User=ai-memory
Group=ai-memory
WorkingDirectory=/opt/ai-memory
EnvironmentFile=/etc/ai-memory/ai-memory.env
ExecStart=/opt/ai-memory/.venv/bin/uvicorn app.api:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
