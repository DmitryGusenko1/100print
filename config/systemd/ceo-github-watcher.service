[Unit]
Description=CEO Orchestrator GitHub Watcher
After=network.target

[Service]
Type=simple
User=ceoorch
Group=ceoorch
WorkingDirectory=/opt/ceo-orchestrator
ExecStart=/opt/ceo-orchestrator/.venv/bin/python /opt/ceo-orchestrator/app/github_watcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
